@model IEnumerable<BoardAppDB.Models.Board>

@{
    ViewData["Title"] = "Board Maintenance";
}

<h1>Board Maintenance</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.BoardCode)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Make)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Model)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FlashKb)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Price)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.BoardCode)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Make)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Model)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FlashKb)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Price)
            </td>
            <td>
                <a asp-action="Edit"
                   asp-route-boardCode="@item.BoardCode">Edit</a> |
                <a asp-action="Details"
                   asp-route-boardCode="@item.BoardCode">Details</a> |
                <a asp-action="Delete"
                   asp-route-boardCode="@item.BoardCode">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>